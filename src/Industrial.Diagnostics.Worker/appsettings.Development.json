{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "IndustrialDb": "Host=localhost;Port=5432;Database=industrial_db;Username=admin;Password=password;SSL Mode=VerifyFull;Root Certificate=certs/dev-ca.crt"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "UseTls": true,
    "SslCaLocation": "certs/dev-ca.crt",
    "SslCertificateLocation": "certs/diagnostics-client.crt",
    "SslKeyLocation": "certs/diagnostics-client.key",
    "GroupId": "diagnostics-group",
    "EventsTopic": "telemetry-events",
    "AlertsTopic": "telemetry-alerts",
    "DeadLetterTopic": "telemetry-events-dlq",
    "ReadinessTimeoutSeconds": 3
  },
  "OTel": {
    "ServiceName": "Industrial.Diagnostics.Worker",
    "Endpoint": "http://localhost:4317"
  },
  "Consumer": {
    "BaseBackoffSeconds": 1,
    "MaxBackoffSeconds": 30
  },
  "Outbox": {
    "IdleDelayMs": 500,
    "BaseBackoffSeconds": 1,
    "MaxBackoffSeconds": 30,
    "PublishedRetentionHours": 168,
    "MaintenanceIntervalSeconds": 30
  },
  "Gemini": {
    "ApiKey": "TODO",
    "Model": "gemini-flash-lite-latest"
  }
}
